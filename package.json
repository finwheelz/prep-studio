{
  "name": "prep-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pyodide.mjs --core",
    "wheels": "node scripts/copy-pyodide.mjs",
    "verify": "tsc --noEmit && tsx scripts/stats.mts && tsx scripts/verify-items.mts --check && tsx scripts/verify-py.mts --quiet && tsx scripts/verify-sql.mts --quiet",
    "verify:items": "tsx scripts/verify-items.mts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electric-sql/pglite": "^0.5.16",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "next": "^14.2.35",
    "pyodide": "^0.26.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
